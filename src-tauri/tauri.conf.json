{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wonderlust Project Organizer",
  "version": "0.1.1",
  "identifier": "com.wonderlust.projectorganizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wonderlust Project Organizer",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#16161B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "publisher": "Wonderlust",
    "copyright": "© Wonderlust",
    "category": "Productivity",
    "shortDescription": "Organiza y respalda proyectos audiovisuales",
    "longDescription": "Crea estructuras de proyecto estandarizadas, clasifica archivos y prepara backups verificados de proyectos audiovisuales.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "./macos/Info.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QTVBMzEwOTU4ODZFQTkKUldTcGJvaVZFS09sSlh1SHpIejQ1dXljeStmdy9mejRseTJGMkdvaGIrYklxb05IQXVGVmNMcDIK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
